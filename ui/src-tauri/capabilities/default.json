{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Lyra's windows are allowed to do. Everything that touches the OS goes through Lyra's own commands.",
  "windows": [
    "island",
    "settings",
    "spotify",
    "mascot",
    "caption",
    "wheel"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
